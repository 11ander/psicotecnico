<?xml version="1.0"?>
<package format="2">
  <name>vision_pkg</name>
  <version>0.0.1</version>
  <description>Prueba de visión para TIAGo</description>

  <!-- Aquí pon un email real -->
  <maintainer email="asier.burgos@opendeusto.es">Asier Burgos</maintainer>
  <!-- Puedes usar la misma licencia que el resto del proyecto -->
  <license>BSD</license>

  <!-- Herramienta de build -->
  <buildtool_depend>catkin</buildtool_depend>

  <!-- Dependencias de compilación -->
  <build_depend>rospy</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>actionlib</build_depend>
  <build_depend>actionlib_msgs</build_depend>
  <build_depend>pal_interaction_msgs</build_depend>
  <build_depend>message_generation</build_depend>

  <!-- Dependencias de ejecución -->
  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>actionlib</exec_depend>
  <exec_depend>actionlib_msgs</exec_depend>
  <exec_depend>pal_interaction_msgs</exec_depend>
  <exec_depend>message_runtime</exec_depend>

  <export/>
</package>
