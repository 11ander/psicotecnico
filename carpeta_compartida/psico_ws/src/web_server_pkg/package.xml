<?xml version="1.0"?>
<package format="2">
  <name>web_server_pkg</name>
  <version>0.0.1</version>
  <description>
    Web server (Flask) que actúa como puente entre las pruebas psicotécnicas del TIAGo y ROS.
  </description>

  <maintainer email="asier.burgos@opendeusto.es">Asier Burgos</maintainer>
  <license>BSD</license>

  <!-- Herramienta de construcción -->
  <buildtool_depend>catkin</buildtool_depend>

  <!-- Dependencias ROS usadas desde Python -->
  <build_depend>rospy</build_depend>
  <build_depend>actionlib</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>move_base_msgs</build_depend>
  <build_depend>tf</build_depend>
  <build_depend>pal_interaction_msgs</build_depend>
  <build_depend>rpi_pkg</build_depend>
  <build_depend>audicion_pkg</build_depend>
  <build_depend>coordinacion_pkg</build_depend>
  <build_depend>face_recognition_pkg</build_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>actionlib</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>move_base_msgs</exec_depend>
  <exec_depend>tf</exec_depend>
  <exec_depend>pal_interaction_msgs</exec_depend>
  <exec_depend>rpi_pkg</exec_depend>
  <exec_depend>audicion_pkg</exec_depend>
  <exec_depend>coordinacion_pkg</exec_depend>
  <exec_depend>face_recognition_pkg</exec_depend>

  <!-- Dependencias Python del sistema (no son ROS, pero lo dejamos documentado) -->
  <exec_depend>python3</exec_depend>
  <!-- En Ubuntu 20.04 (Noetic) puedes instalar Flask así: sudo apt install python3-flask -->
  <exec_depend>python3-flask</exec_depend>
  <!-- Para report.py (ReportLab) -->
  <exec_depend>python3-reportlab</exec_depend>

  <export>
    <!-- Nada especial que exportar -->
  </export>
</package>
